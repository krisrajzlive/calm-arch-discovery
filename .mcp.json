{
  "mcpServers": {
    "neo4j-calm-graph": {
      "command": "uvx",
      "args": ["mcp-neo4j-cypher@0.6.0", "--read-only"],
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USERNAME": "neo4j",
        "NEO4J_PASSWORD": "${NEO4J_PASSWORD}",
        "NEO4J_DATABASE": "neo4j"
      }
    }
  }
}
