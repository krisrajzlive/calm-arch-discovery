{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/krisrajzlive/calm-arch-discovery/main/controls/container-hardening.requirement.json",
  "title": "Container hardening",
  "description": "Workload runs as non-root with privilege escalation disabled.",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "verified",
        "unverified"
      ],
      "description": "verified = the scanner found evidence in the repository; unverified = required by policy but no evidence found."
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Repository-relative files (and detail) that evidence the control."
    },
    "run-as-non-root": {
      "type": "boolean"
    },
    "allow-privilege-escalation": {
      "type": "boolean"
    },
    "read-only-root-filesystem": {
      "type": "boolean"
    }
  },
  "required": [
    "status",
    "evidence"
  ],
  "if": {
    "properties": {
      "status": {
        "const": "verified"
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "properties": {
      "evidence": {
        "minItems": 1
      }
    }
  },
  "additionalProperties": false
}
